# ============================================================================
# Anansi feature flags & tunable settings
# AUTOGENERATED from shared/config/flag_registry.py — DO NOT EDIT BY HAND.
# Regenerate with:  python -m shared.config.flag_registry > shared/config/flags.env.example
#
# These are operator-tunable toggles and knobs only. Secrets and connection
# strings (API keys, AUTH_DB_*, CHAT_DB_*, tokens) live in each service's own
# .env.example and are never managed here.
# ============================================================================

# Master switch for the Telegram bot.
BOT_ENABLED=true

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Maximum sequential tool-call rounds per turn.
MAX_TOOL_ROUNDS=5

# Allow Gemini to request parallel tool calls.
ALLOW_PARALLEL_CALLS=true

# Generation provider: 'gemini' for direct Google Gemini or 'openrouter' for OpenRouter.
LLM_PROVIDER=gemini

# Primary generation model id for the selected provider.
GEMINI_MODEL=gemini-2.5-flash

# Fallback generation model id for the selected provider.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Model for deep-thinking tasks (document editing, complex analysis).
GEMINI_DEEP_THINKING_MODEL=gemini-pro-latest

# Lightweight model for structured natural-language expert routing.
INTENT_ROUTER_MODEL=gemini-2.5-flash-lite

# Model used for response verification.
VERIFICATION_MODEL=gemini-2.5-flash-lite

# Embedding model used for RAG ingestion/retrieval. (read-only)
EMBEDDING_MODEL=gemini-embedding-001

# Generation temperature where supported by the selected model.
GEMINI_TEMPERATURE=0.2

# Max output tokens for the primary model.
GEMINI_MAX_OUTPUT_TOKENS=8192

# Max output tokens for the lite/verification model. (read-only)
GEMINI_LITE_MAX_OUTPUT_TOKENS=1024

# Optional comma-separated OpenRouter provider slugs to try first, e.g. 'google-vertex' for Google Vertex BYOK.
OPENROUTER_PROVIDER_ORDER=

# Allow OpenRouter to fall back to other endpoints when provider routing is configured.
OPENROUTER_ALLOW_FALLBACKS=true

# Require OpenRouter endpoints that support the requested parameters/tool schema.
OPENROUTER_REQUIRE_PARAMETERS=false

# Thinking-token budget for Gemini 2.5 models (-1 dynamic, 0 off, >0 cap).
GEMINI_THINKING_BUDGET=4096

# Model for complex agent tasks (analysis, multi-step reasoning).
GEMINI_AGENT_PRO_MODEL=gemini-2.5-pro

# Model that assigns incoming messages to conversation threads.
THREAD_CLASSIFIER_MODEL=gemini-2.5-flash-lite

# Allow Google Search grounding for staff users.
GOOGLE_SEARCH_GROUNDING=true

# Prompt the user to confirm editable workflow parameters.
WORKFLOW_PARAMETER_CONFIRMATION=true

# Telegram inline buttons for decision prompts.
INLINE_BUTTONS_ENABLED=false

# Procedure buttons in customer support chats.
PROCEDURE_BUTTONS_ENABLED=false

# Telegram WebApp popups for workflow parameters.
MINI_APP_FORMS_ENABLED=false

# Conversation context filtering.
CONTEXT_FILTER_ENABLED=false

# Multi-thread conversation disentanglement.
THREAD_DISENTANGLEMENT_ENABLED=false

# Window (minutes) a thread stays active.
ACTIVE_THREAD_WINDOW_MINUTES=60

# Rolling conversation summarization.
CONVERSATION_SUMMARY_ENABLED=false

# Enable user-created persistent monitoring agents.
PERSISTENT_AGENTS_ENABLED=false

# Timeout (minutes) for an expert awaiting user input.
AWAITING_INPUT_TIMEOUT_MINUTES=180

# Enable LLM-as-judge verification of outgoing customer messages.
VERIFICATION_ENABLED=false

# Google Doc id holding verification criteria.
VERIFICATION_DOC_ID=

# Enable Langfuse LLM observability tracing.
LANGFUSE_ENABLED=false

# Maximum actions a persistent agent may take in one wake cycle.
AGENT_MAX_ACTIONS_PER_WAKE=10

# Maximum sequential tool-call rounds inside one persistent-agent action.
AGENT_MAX_TOOL_ROUNDS=5

# Detect and break repeated identical tool calls within a turn.
LOOP_DETECTION_ENABLED=true

# Identical repeats before a tool call is treated as a loop.
LOOP_DETECTION_THRESHOLD=2

# Maximum sites evaluated in parallel by multi-site workflows.
MULTI_SITE_MAX_CONCURRENCY=5

# Which ticket backend customer escalations use: 'auto' (Jira if configured and healthy, else internal), 'jira' (Jira if creds present, else internal -- never hard-fails), or 'internal' (always internal). Ops kill-switch / forcing.
TICKET_BACKEND_OVERRIDE=auto

# Which ticket backend /notify-originated tickets use: 'internal' (default -- ops alerts from Grafana/n8n/VRM never land in the Jira OPS project) or 'auto' (Jira if configured and healthy, else internal, same as customer escalations).
NOTIFY_TICKETS_BACKEND=internal

# Prefix for internal ticket refs allocated when the internal backend is used, e.g. 'TKT' -> 'TKT-000123'.
INTERNAL_TICKET_PREFIX=TKT

# Jira project key used when the Jira ticket backend is selected.
JIRA_PROJECT_KEY=OPS

# How long JiraTicketBackend caches its Jira health probe result before re-checking (seconds).
JIRA_HEALTHCHECK_TTL_SECONDS=60

# File a ticket automatically for every new escalation, same as the existing after-hours behavior, instead of showing staff the Track button to opt in. Off (default) keeps today's staff-triggered tracking.
ALWAYS_FILE_ESCALATION_AS_TICKET=false

# Master switch for /notify ticket_id='auto' correlation. Off: 'auto' behaves exactly like '' (plain create) -- the kill switch can never drop an alert.
ALERT_CORRELATION_ENABLED=false

# Maximum seconds to wait for the one live VRM inverter-output lookup before reporting it as unavailable.
URGENT_ALERT_LIVE_OUTPUT_TIMEOUT_SECONDS=3

# Run the periodic Jira sweep that reconciles ticket state.
JIRA_SWEEP_ENABLED=true

# Jira issue type used for tickets when the project offers no better match.
JIRA_ISSUE_TYPE=Task

# Scan for orphaned work on startup. Must be false when running more than one orchestrator instance.
STARTUP_RECOVERY_ENABLED=true

# Accept external notifications on POST /chat/notify and forward them to Telegram (n8n / VRM / Grafana passthrough). When off the endpoint returns 503.
NOTIFY_ENDPOINT_ENABLED=false

# Telegram chat id for the escalation group. (read-only)
ESCALATION_TELEGRAM_CHAT_ID=

# Telegram chat id for debug output. (read-only)
DEBUG_TELEGRAM_CHAT_ID=

# Comma-separated Telegram chat ids the bot never replies in.
NO_REPLY_CHAT_IDS=

# Timezone for after-hours escalation logic. Empty falls back to DEFAULT_TIMEZONE.
AFTER_HOURS_TIMEZONE=

# Hour (0-23) when after-hours escalation handling begins.
AFTER_HOURS_START_HOUR=19

# Enable the equipment diagnostics MCP server (disabling hides all of its tools).
EQUIPMENT_DIAGNOSTICS_ENABLED=true

# Enable the jira MCP server (disabling hides all of its tools).
JIRA_ENABLED=true

# Enable the meters MCP server (disabling hides all of its tools).
METERS_ENABLED=true

# Enable the equipment control MCP server (disabling hides all of its tools).
EQUIPMENT_CONTROL_ENABLED=true

# Enable the payment processor MCP server (disabling hides all of its tools).
PAYMENT_PROCESSOR_ENABLED=true

# Enable the customer MCP server (disabling hides all of its tools).
CUSTOMER_ENABLED=true

# Enable the grafana MCP server (disabling hides all of its tools).
GRAFANA_ENABLED=true

# Enable the schedule MCP server (disabling hides all of its tools).
SCHEDULE_ENABLED=true

# Enable the meta MCP server (disabling hides all of its tools).
META_ENABLED=true

# Enable the grid design MCP server (disabling hides all of its tools).
GRID_DESIGN_ENABLED=true

# Enable the solar MCP server (disabling hides all of its tools).
SOLAR_ENABLED=true

# Enable the knowledge MCP server (disabling hides all of its tools).
KNOWLEDGE_ENABLED=true

# Enable the messaging MCP server (disabling hides all of its tools).
MESSAGING_ENABLED=true

# Enable the reference MCP server (disabling hides all of its tools).
REFERENCE_ENABLED=true

# Allow write/action tools on the equipment diagnostics MCP server (read-only tools are unaffected).
EQUIPMENT_DIAGNOSTICS_ACTIONS_ENABLED=false

# Allow write/action tools on the jira MCP server (read-only tools are unaffected).
JIRA_ACTIONS_ENABLED=false

# Allow write/action tools on the meters MCP server (read-only tools are unaffected).
METERS_ACTIONS_ENABLED=false

# Allow write/action tools on the equipment control MCP server (read-only tools are unaffected).
EQUIPMENT_CONTROL_ACTIONS_ENABLED=false

# Allow write/action tools on the payment processor MCP server (read-only tools are unaffected).
PAYMENT_PROCESSOR_ACTIONS_ENABLED=false

# Allow write/action tools on the customer MCP server (read-only tools are unaffected).
CUSTOMER_ACTIONS_ENABLED=false

# Allow write/action tools on the grafana MCP server (read-only tools are unaffected).
GRAFANA_ACTIONS_ENABLED=false

# Allow write/action tools on the schedule MCP server (read-only tools are unaffected).
SCHEDULE_ACTIONS_ENABLED=false

# Allow write/action tools on the meta MCP server (read-only tools are unaffected).
META_ACTIONS_ENABLED=false

# Allow write/action tools on the grid design MCP server (read-only tools are unaffected).
GRID_DESIGN_ACTIONS_ENABLED=false

# Allow write/action tools on the solar MCP server (read-only tools are unaffected).
SOLAR_ACTIONS_ENABLED=false

# Allow write/action tools on the knowledge MCP server (read-only tools are unaffected).
KNOWLEDGE_ACTIONS_ENABLED=false

# Allow write/action tools on the messaging MCP server (read-only tools are unaffected).
MESSAGING_ACTIONS_ENABLED=false

# Allow write/action tools on the reference MCP server (read-only tools are unaffected).
REFERENCE_ACTIONS_ENABLED=false

# JSON array of "server:tool" strings to disable individual tools.
MCP_DISABLED_TOOLS=[]

# Enable retrieval-augmented generation.
rag__enabled=false

# Number of RAG chunks to retrieve per query.
rag__top_k=5

# Grafana base URL.
GRAFANA_URL=http://localhost:3000

# Grafana username.
GRAFANA_USERNAME=

# Grafana password. (secret)
GRAFANA_PASSWORD=

# Grafana folder to source dashboards from.
GRAFANA_FOLDER_NAME=

# Comma-separated dashboard UIDs to expose as tools.
GRAFANA_ENABLED_DASHBOARDS=

# Comma-separated list of enabled Grafana panels.
GRAFANA_ENABLED_PANELS=

# Hour of day (0-23) to sync Grafana panel metadata.
GRAFANA_SYNC_HOUR=2

# Force a full Grafana panel reindex on next sync.
GRAFANA_FORCE_FULL_REINDEX=false

# Seconds allowed for a Grafana panel query.
GRAFANA_QUERY_TIMEOUT=180

# Seconds allowed for a Grafana metadata fetch.
GRAFANA_METADATA_TIMEOUT=30

# Seconds allowed for a Grafana variable lookup.
GRAFANA_VARIABLE_TIMEOUT=60

# Spacing between poles along roads (m).
LAYOUT_POLE_SPACING_M=45.0

# Max drop-cable length to a building (m).
LAYOUT_MAX_DROP_DISTANCE_M=40.0

# Target building coverage (%).
LAYOUT_TARGET_COVERAGE_PCT=90.0

# Roof area per kWp (m²/kWp).
LAYOUT_SQM_PER_KWP=15.5

# Estimated kWp per building.
LAYOUT_KWP_PER_BUILDING=0.25

# Minimum estimated site kWp.
LAYOUT_MIN_ESTIMATED_KWP=30.0

# Buffer around buildings (m).
LAYOUT_BUILDING_BUFFER_M=15.0

# Setback from site boundary (m).
LAYOUT_SITE_SETBACK_M=5.0

# Setback from roads (m).
LAYOUT_ROAD_SETBACK_M=5.0

# Corridor clearance (m).
LAYOUT_CORRIDOR_CLEARANCE_M=10.0

# Tree-canopy avoidance threshold (m).
LAYOUT_CANOPY_THRESHOLD_M=5.0

# Min separation between candidate sites (m).
LAYOUT_MIN_CANDIDATE_SEPARATION_M=100.0

# Max candidate sites to evaluate.
LAYOUT_MAX_CANDIDATES=3

# Distance under which poles are deduplicated (m).
LAYOUT_POLE_DEDUP_DISTANCE_M=5.0

# Node-snapping tolerance (m).
LAYOUT_SNAP_NODE_TOLERANCE_M=1.0

# Gap under which segments merge (m).
LAYOUT_MERGE_GAP_THRESHOLD_M=5.0

# Max gap for pole redistribution (m).
LAYOUT_REDISTRIBUTE_GAP_MAX_M=10.0

# Lightning-protection radius (m).
LAYOUT_LIGHTNING_RADIUS_M=13.5

# Explicit kW per household. 0 lets the pipeline derive it.
LAYOUT_KW_PER_HOUSEHOLD=0.0

# Longest gap the distribution network may bridge (m).
LAYOUT_MAX_BRIDGE_DISTANCE_M=200.0

# Distance under which parallel road paths are treated as redundant (m).
LAYOUT_PATH_REDUNDANCY_DISTANCE_M=22.5

# Routing penalty applied to building-adjacent paths.
LAYOUT_PATH_WEIGHT_PENALTY=3.0

# Search radius when connecting the plant to the network (m).
LAYOUT_PLANT_CONNECT_DISTANCE_M=150.0

# Number of candidate connection points evaluated for the plant.
LAYOUT_PLANT_CONNECT_K=5

# Power factor used to convert kVA to kW.
LAYOUT_POWER_FACTOR=0.95

# Buffer around the site used to clip the road network (m).
LAYOUT_ROAD_CLIP_BUFFER_M=100.0

# Exclusion buffer around waterways (m).
LAYOUT_WATERWAY_BUFFER_M=200.0

# Google Doc id holding expert/workflow definitions.
EXPERT_INSTRUCTIONS_DOC_ID=

# Google Doc id for customer-mode system instructions. (read-only)
CUSTOMER_SUPPORT_DOC_ID=

# Google Doc id for staff-mode system instructions. (read-only)
STAFF_SUPPORT_DOC_ID=

# Google Doc id for shared troubleshooting procedures. (read-only)
TROUBLESHOOTING_PROCEDURES_DOC_ID=

# Comma-separated emails in the ops prompt-editor group. (read-only)
PROMPT_EDITORS_OPS=

# Comma-separated emails in the engineering prompt-editor group. (read-only)
PROMPT_EDITORS_ENG=

# Comma-separated emails with full access to every prompt. (read-only)
PROMPT_ADMINS=

# Google Slides template id for LPP output.
LPP_TEMPLATE_ID=

# QGIS template file id for site layouts.
QGIS_TEMPLATE_FILE_ID=

# Drive folder id for LPP output.
LPP_OUTPUT_FOLDER_ID=

# Sheet id for import tariff reference data.
NIGERIA_IMPORT_TARIFF_SHEET_ID=

# PDF id for import standards reference data.
NIGERIA_IMPORT_STANDARDS_PDF_ID=

# Comma-separated emails allowed to view the admin app.
ALLOWED_VIEWER_EMAILS=

# Comma-separated emails allowed to issue equipment-control commands.
EQUIPMENT_CONTROL_ALLOWED_USERS=

# Comma-separated emails with view-only access to the Grid Design tables.
GRID_DESIGN_ALLOWED_USERS=

# Comma-separated emails allowed to edit all Grid Design tables except Procurements.
GRID_DESIGN_EDITORS=

# Comma-separated emails allowed to edit only the Procurements (Purchases/BoS) table.
GRID_PROCUREMENT_EDITORS=

# Organization id treated as internal staff (full tool access). (read-only)
STAFF_ORG_ID=2

# Display name for the internal staff organization.
STAFF_ORG_NAME=Staff

# Grids-table column marking operator-managed generation. Interpolated into SQL, so use only valid PostgreSQL identifier characters.
MANAGED_GENERATION_COLUMN=is_generation_managed_by_nxt_grid

# Enable scheduled metrics collection.
METRICS_ENABLED=true

# Hour of day (0-23) to run metrics collection.
METRICS_SCHEDULE_HOUR=9

# Timezone used to schedule metrics collection.
METRICS_TIMEZONE=UTC

# IANA timezone used as the fallback for display/scheduling when a grid has no timezone of its own (e.g. 'Africa/Lagos', 'UTC'). (read-only)
DEFAULT_TIMEZONE=UTC

# Backend for runtime settings management: 'auto' (DigitalOcean if DIGITALOCEAN_APP_ID + token are set, else env-file), 'digitalocean', or 'envfile'. (read-only)
SETTINGS_BACKEND=auto

# Path the env-file settings backend reads/writes when not on DigitalOcean. (read-only)
SETTINGS_FILE=.env.settings

# Operator name shown in chart watermarks and equipment messages.
ORGANIZATION_NAME=the operator

# Prefix for generated document reference codes.
DOC_CODE_PREFIX=DOC

# OpenRouter API key. (secret)
OPENROUTER_API_KEY=

# Tavily web-search key for the knowledge server. (secret)
TAVILY_API_KEY=
