# =============================================================================
# anansi_app — Environment Variables
# Copy this file to .env and fill in your values.
#
# This file covers host-level credentials only: OAuth, database, Telegram,
# and platform connections. Every operator-tunable flag (model choice, LLM
# provider, Grafana settings, layout parameters, feature toggles) is managed
# through the Settings page and documented in full, with defaults and
# descriptions, in shared/config/flags.env.example — see that file rather
# than duplicating a stale copy of it here.
# =============================================================================

# ---- Google OAuth (for admin UI login) ----------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
AUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
AUTH_CLIENT_SECRET=your-oauth-client-secret
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
AUTH_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_COOKIE_SECRET=generate-a-random-secret-here
# Aliases used by some auth components (same values as AUTH_CLIENT_*)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ---- Google AI (for Grafana indexer scripts and Gemini generation) -------
GOOGLE_API_KEY=your-google-ai-studio-api-key
# OpenRouter key, if LLM_PROVIDER=openrouter is set on the Settings page.
# OPEN_ROUTER_BEARER_TOKEN is also accepted as a local alias.
OPENROUTER_API_KEY=

# ---- Chat Database (Supabase) -------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ---- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# ---- Admin access -------------------------------------------------------
# Comma-separated Google account emails allowed to access the admin UI.
# Grants the Bot Admin section AND view access to the Grid Design section.
ALLOWED_VIEWER_EMAILS=admin@example.com
# API key used to authenticate calls to the orchestrator (same value as orchestrator API_KEY)
API_KEY=your-orchestrator-api-key
# Required for the Skill Builder page (/skill-builder) AND the in-app chat
# widget (bottom-right on every admin page) to send messages. Without it the
# orchestrator's is_identity_trusted_caller fails closed, resolve_auth ignores
# the admin_app_auth opt-in, and a chat session would silently run unscoped --
# so the widget disables sending and says so instead.
# Same value as the orchestrator's IDENTITY_ASSERTION_KEY -- a secret
# DISTINCT from API_KEY (do not reuse the same value for both). Lets the
# builder assert the logged-in staff user's real email on chat_orchestrator's
# POST /chat, since the builder's synthetic per-draft user_id never matches a
# real Auth DB account. See chat_orchestrator/.env.example and
# orchestrator/api/app.py's is_identity_trusted_caller for why this must stay
# separate from API_KEY.
IDENTITY_ASSERTION_KEY=

# ---- Grid Design access control -----------------------------------------
# The Grid Design section is visible to the UNION of all four whitelists below
# (ALLOWED_VIEWER_EMAILS + the three here). A user in none of them is denied.
# Edit rights are strictly separated; everyone else sees grid tables read-only.
#
# View-only access to all grid tables (no edit):
GRID_DESIGN_ALLOWED_USERS=
# Can EDIT every grid table EXCEPT Purchases (BoS):
GRID_DESIGN_EDITORS=
# Can EDIT only the Purchases (BoS) table:
GRID_PROCUREMENT_EDITORS=
# Local-dev ONLY: set to 1 to bypass Google OAuth and grant all permissions.
# NEVER set this in production.
# GRID_DESIGN_DEV_NO_AUTH=0

# ---- Chat orchestrator connection ---------------------------------------
# Base URL of chat_orchestrator. Used by the scheduled-command runner, the
# skill builder, and the in-app chat widget. A trailing "/chat" is tolerated
# and stripped (production sets the bare service URL via
# ${chat-orchestrator.PRIVATE_URL}); callers append their own path.
CHAT_ORCHESTRATOR_URL=http://localhost:8000
ANANSI_BOT_HEALTH_URL=http://localhost:8000/health
MINI_APP_BASE_URL=http://localhost:8000/mini-app

# ---- DigitalOcean (for Settings page — controls live env vars) ----------
# Leave blank if not using DigitalOcean App Platform
DIGITALOCEAN_APP_ID=
DIGITALOCEAN_API_TOKEN=

# Grafana connection, staff org id, default timezone, and after-hours timing
# are all operator-tunable — set them from the Settings page once this app is
# running; see shared/config/flags.env.example for their names and defaults.

# ---- LLM Observability (Langfuse — optional) ----------------------------
LANGFUSE_DASHBOARD_URL=                      # e.g. https://cloud.langfuse.com/project/<your-project-id>

# ---- Debug --------------------------------------------------------------
LOG_LEVEL=INFO
